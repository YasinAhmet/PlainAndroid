<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "Remove the old app" after its data was copied (Android shows its own confirm dialog). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <application>
        <!-- Copy a former app's data before its tab opens the first time (see app.plain.migrate). -->
        <activity
            android:name="app.plain.migrate.ImportActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Intents from other apps, handed to a tab in the app's one task. Each app's manifest declares
             activity-aliases of it with <meta-data android:name="app.plain.hub.TAB" android:value="<tab key>" />. -->
        <activity
            android:name="app.plain.hub.ForwardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
