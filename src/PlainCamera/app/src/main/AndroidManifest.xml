<?xml version="1.0" encoding="utf-8"?>
<!-- Plain Camera: Camera, Gallery and Record Voice tabs (the tab modules bring their own activities, services and permissions). Offline: no INTERNET. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the former Plain Gallery, to copy its data once (package visibility, Android 11+) -->
    <queries>
        <package android:name="app.plain.gallery" />
    </queries>
    <application
        android:name=".CameraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- the launcher icon: opens the last used tab -->
        <activity
            android:name="app.plain.hub.HubActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- intents from other apps: handed to the tab inside the app's one task (app.plain.hub.ForwardActivity) -->
        <activity
            android:name="app.plain.hub.ForwardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- "open the camera app" (captures for other apps stay on CameraActivity itself) -->
        <activity-alias
            android:name="app.plain.hub.OpenCamera"
            android:exported="true"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="camera" />
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- "open the gallery app" -->
        <activity-alias
            android:name="app.plain.hub.OpenGallery"
            android:exported="true"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="gallery" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
