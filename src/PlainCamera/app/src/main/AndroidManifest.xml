<?xml version="1.0" encoding="utf-8"?>
<!-- Plain Camera: Camera and Gallery tabs (the tab modules bring their own activities and permissions). Offline: no INTERNET. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the former Plain Gallery, to copy its data once (package visibility, Android 11+) -->
    <queries>
        <package android:name="app.plain.gallery" />
    </queries>
    <application
        android:name=".CameraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- the launcher icon: opens the last used tab -->
        <activity
            android:name="app.plain.hub.HubActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
