<resources>
    <style name="voc_AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#E6B422</item>
        <item name="android:colorPrimary">#000000</item>
        <item name="android:textColorPrimary">#E4E4E4</item>
        <item name="android:textColorSecondary">#A6A6A6</item>
        <item name="android:textColorHint">#747474</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:alertDialogTheme">@style/voc_BlackDialog</item>
        <item name="android:popupMenuStyle">@style/voc_BlackPopup</item>
    </style>
    <style name="voc_BlackPopup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/voc_menu_bg</item>
    </style>
    <style name="voc_BlackDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/voc_dialog_bg</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#E6B422</item>
        <item name="android:textColorPrimary">#E4E4E4</item>
        <item name="android:textColorSecondary">#A6A6A6</item>
        <item name="android:textColorHint">#747474</item>
    </style>
</resources>
