<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Online only when the user taps Check / Install (or another Plain app asks for its update). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Android 12+: lets Setup update apps it installed without a confirm dialog. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- To read installed versions of the Plain apps (Android 11 package visibility). -->
    <queries>
        <package android:name="app.localmusic" />
        <package android:name="app.plain.camera" />
        <package android:name="app.plain.gallery" />
        <package android:name="app.trekmap.trail" />
        <package android:name="app.plain.maps" />
        <package android:name="app.plain.maps.ankara" />
        <package android:name="app.plain.download" />
        <package android:name="app.plain.home" />
        <package android:name="app.plain.battery" />
        <package android:name="app.plain.uninstaller" />
        <!-- Shizuku, for quiet installs (Shiz.kt). -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Future Plain apps: every one has a launcher icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/SetupTheme">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Check for updates" in any Plain app (see app.plain.update.PlainUpdate). -->
            <intent-filter>
                <action android:name="app.plain.setup.UPDATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Shizuku hands its binder to the app through this provider (as documented by Shizuku). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
