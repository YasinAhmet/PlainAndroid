<?xml version="1.0" encoding="utf-8"?>
<!-- Plain Manager: Setup, Battery and Uninstaller tabs (the tab modules bring their activities and permissions). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The Battery tab needs Android 10; on older phones it is hidden (Hub tab minSdk) and the rest still works. -->
    <uses-sdk tools:overrideLibrary="app.plain.battery" />
    <application
        android:name=".ManagerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- the launcher icon: opens the last used tab -->
        <activity
            android:name="app.plain.hub.HubActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- intents from other apps: handed to the tab inside the app's one task (app.plain.hub.ForwardActivity) -->
        <activity
            android:name="app.plain.hub.ForwardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- "Check for updates" in any Plain app (see app.plain.update.PlainUpdate) -->
        <activity-alias
            android:name="app.plain.hub.UpdateRequest"
            android:exported="true"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="setup" />
            <intent-filter>
                <action android:name="app.plain.setup.UPDATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
