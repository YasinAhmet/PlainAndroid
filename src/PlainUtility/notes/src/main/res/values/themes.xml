<resources>
    <style name="nts_AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#A594F9</item>
        <item name="android:colorPrimary">#000000</item>
        <item name="android:textColorPrimary">#E4E4E4</item>
        <item name="android:textColorSecondary">#A6A6A6</item>
        <item name="android:textColorHint">#747474</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:alertDialogTheme">@style/nts_BlackDialog</item>
        <item name="android:datePickerDialogTheme">@style/nts_Picker</item>
        <item name="android:timePickerDialogTheme">@style/nts_Picker</item>
    </style>
    <style name="nts_BlackDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/nts_dialog_bg</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#A594F9</item>
        <item name="android:textColorPrimary">#E4E4E4</item>
        <item name="android:textColorSecondary">#A6A6A6</item>
        <item name="android:textColorHint">#747474</item>
    </style>
    <!-- date and time pickers: black headers (OLED), accent only for the selection -->
    <style name="nts_Picker" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/nts_dialog_bg</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#A594F9</item>
        <item name="android:textColorPrimary">#E4E4E4</item>
        <item name="android:textColorSecondary">#A6A6A6</item>
        <item name="android:datePickerStyle">@style/nts_DatePicker</item>
        <item name="android:timePickerStyle">@style/nts_TimePicker</item>
    </style>
    <style name="nts_DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">#000000</item>
    </style>
    <style name="nts_TimePicker" parent="android:Widget.Material.TimePicker">
        <item name="android:headerBackground">#000000</item>
        <item name="android:numbersBackgroundColor">#000000</item>
    </style>
</resources>
