<?xml version="1.0" encoding="utf-8"?>
<!-- Plain Utility: Clock and Notes tabs (the tab modules bring their own activities, receivers and permissions). Offline: no INTERNET. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".UtilityApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- the launcher icon: opens the last used tab -->
        <activity
            android:name="app.plain.hub.HubActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- notifications and other apps: handed to the tab inside the app's one task -->
        <activity
            android:name="app.plain.hub.ForwardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- "set a timer" from other apps / the assistant opens the Clock tab -->
        <activity-alias
            android:name="app.plain.hub.OpenClock"
            android:exported="true"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="clock" />
            <intent-filter>
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- text shared from other apps becomes a note -->
        <activity-alias
            android:name="app.plain.hub.OpenNotes"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="notes" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <!-- a routine's notification opens the Routines tab -->
        <activity-alias
            android:name="app.plain.hub.OpenRoutines"
            android:exported="false"
            android:targetActivity="app.plain.hub.ForwardActivity">
            <meta-data android:name="app.plain.hub.TAB" android:value="routines" />
        </activity-alias>
    </application>
</manifest>
